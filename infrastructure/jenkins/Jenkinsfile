pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    environment {
        DOCKER_REGISTRY = 'your-registry.io/newsportal'
        APP_NAME        = 'news-portal-api'
        FRONTEND_NAME   = 'news-portal-web'
        SONAR_PROJECT   = 'news-portal'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log --oneline -5'
            }
        }

        stage('Backend: Test') {
            steps {
                dir('backend') {
                    sh './mvnw test -Dspring.profiles.active=test --no-transfer-progress'
                    junit 'target/surefire-reports/**/*.xml'
                }
            }
            post {
                always {
                    jacoco(execPattern: 'backend/target/jacoco.exec')
                }
            }
        }

        stage('Backend: Code Quality') {
            when { branch pattern: 'develop|main', comparator: 'REGEXP' }
            steps {
                dir('backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh './mvnw sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT} --no-transfer-progress'
                    }
                }
            }
        }

        stage('Backend: Security Scan') {
            when { branch 'main' }
            steps {
                dir('backend') {
                    sh './mvnw org.owasp:dependency-check-maven:check --no-transfer-progress'
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: 'backend/target/dependency-check-report.xml'
                }
            }
        }

        stage('Backend: Build JAR') {
            steps {
                dir('backend') {
                    sh './mvnw package -DskipTests --no-transfer-progress'
                    archiveArtifacts artifacts: 'target/news-portal-api.jar'
                }
            }
        }

        stage('Frontend: Build') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Docker: Build & Push') {
            when { branch pattern: 'develop|main', comparator: 'REGEXP' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-registry-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh "echo $DOCKER_PASS | docker login ${DOCKER_REGISTRY} -u $DOCKER_USER --password-stdin"
                    sh "docker build -t ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER} ./backend"
                    sh "docker build -t ${DOCKER_REGISTRY}/${FRONTEND_NAME}:${BUILD_NUMBER} ./frontend"
                    sh "docker push ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}"
                    sh "docker push ${DOCKER_REGISTRY}/${FRONTEND_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('DB Migration: Staging') {
            when { branch 'develop' }
            steps {
                withCredentials([
                    string(credentialsId: 'staging-db-url',  variable: 'DB_URL'),
                    string(credentialsId: 'staging-db-user', variable: 'DB_USER'),
                    string(credentialsId: 'staging-db-pass', variable: 'DB_PASS')
                ]) {
                    dir('backend') {
                        sh """
                            ./mvnw flyway:migrate \
                              -Dflyway.url=${DB_URL} \
                              -Dflyway.user=${DB_USER} \
                              -Dflyway.password=${DB_PASS} \
                              --no-transfer-progress
                        """
                    }
                }
            }
        }

        stage('Deploy: Staging') {
            when { branch 'develop' }
            steps {
                sh """
                    docker-compose -f infrastructure/docker-compose.yml \
                        up -d --no-deps backend frontend
                """
                echo "Staging deployed: ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}"
            }
        }

        stage('Deploy: Production') {
            when { branch 'main' }
            input {
                message "Deploy ${APP_NAME}:${BUILD_NUMBER} to PRODUCTION?"
                ok "Deploy Now"
                submitter "admin,lead-engineer"
            }
            steps {
                withCredentials([
                    string(credentialsId: 'prod-db-url',  variable: 'DB_URL'),
                    string(credentialsId: 'prod-db-user', variable: 'DB_USER'),
                    string(credentialsId: 'prod-db-pass', variable: 'DB_PASS')
                ]) {
                    dir('backend') {
                        sh """
                            ./mvnw flyway:migrate \
                              -Dflyway.url=${DB_URL} \
                              -Dflyway.user=${DB_USER} \
                              -Dflyway.password=${DB_PASS} \
                              --no-transfer-progress
                        """
                    }
                }
                // Replace with kubectl set image for Kubernetes
                echo "Deploying ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER} to production..."
                sh """
                    kubectl set image deployment/${APP_NAME} \
                        ${APP_NAME}=${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER} \
                        -n production
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded: ${APP_NAME} build ${BUILD_NUMBER}"
        }
        failure {
            emailext(
                subject: "FAILED: ${APP_NAME} build ${BUILD_NUMBER}",
                body: "Build ${BUILD_NUMBER} failed. Check: ${BUILD_URL}",
                to: 'team@newsportal.com'
            )
        }
        always {
            cleanWs()
        }
    }
}
